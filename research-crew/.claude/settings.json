{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Grep",
      "Glob",
      "mcp__news-archive__*",
      "Edit(reports/**)"
    ],
    "deny": [
      "Bash"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "false"
  }
}
